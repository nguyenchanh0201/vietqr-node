{
  "name": "vietqr-node",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "VietQR / NAPAS247 for Node: build, parse, decode and render payment QR codes offline. TypeScript port of vietqr-core.",
  "keywords": [
    "vietqr",
    "napas",
    "napas247",
    "emvco",
    "qr",
    "qrcode",
    "vietnam",
    "payment",
    "bank",
    "nestjs"
  ],
  "author": "Chánh Nguyễn <chanhnguyen34@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyenchanh0201/vietqr-node.git"
  },
  "homepage": "https://github.com/nguyenchanh0201/vietqr-node#readme",
  "bugs": {
    "url": "https://github.com/nguyenchanh0201/vietqr-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./deeplink": {
      "import": {
        "types": "./dist/deeplink/index.d.ts",
        "default": "./dist/deeplink/index.js"
      },
      "require": {
        "types": "./dist/deeplink/index.d.cts",
        "default": "./dist/deeplink/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.ts",
        "default": "./dist/nestjs/index.js"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsup"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "qrcode": "1.5.4",
    "zxing-wasm": "3.1.6"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "reflect-metadata": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/testing": "11.1.29",
    "@types/express": "5.0.6",
    "@types/node": "^20.19.0",
    "@types/supertest": "6.0.3",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "supertest": "7.3.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
